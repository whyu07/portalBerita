# Copy this file to the project root as .env. Never commit the real .env file.

POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=portal_berita_prod

# At least 32 characters. Generate a unique value for every deployment.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_HOURS=24

# Keep disable for the PostgreSQL container in this compose file.
# Use require when connecting to an external PostgreSQL with TLS.
DB_SSLMODE=disable

# Use the real public origin, without a trailing slash.
CORS_ORIGINS=https://news.example.com
VITE_API_BASE_URL=/api/v1

# First-admin bootstrap: fill these only for the first startup.
# Remove all three values after the first successful admin login.
BOOTSTRAP_ADMIN_NAME=Portal Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_password_at_least_12_chars
