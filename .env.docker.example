# Docker Compose Environment Variables Example
# Do not commit the actual .env file to Git!

# PostgreSQL Variables
POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=super_secret_db_password
POSTGRES_DB=portal_berita_prod

# Backend Variables
JWT_SECRET=generate_a_very_long_random_string_here
JWT_EXPIRES_HOURS=24
DB_SSLMODE=disable
CORS_ORIGINS=https://news.example.com
VITE_API_BASE_URL=/api/v1

# Optional: set these only for the first production startup to create an admin.
# Remove them from the production secret after the first successful login.
# BOOTSTRAP_ADMIN_NAME=Portal Admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_password_at_least_12_chars
