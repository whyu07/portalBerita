APP_ENV=production
PORT=8080
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_HOURS=24
SEED_DEMO_DATA=false

# Database Configuration (PostgreSQL)
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=<production-database-user>
DB_PASSWORD=<secret-password>
DB_NAME=<production-database-name>
DB_SSLMODE=require
